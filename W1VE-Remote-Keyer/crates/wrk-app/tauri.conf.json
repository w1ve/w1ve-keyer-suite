{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "W1VE Remote Keyer",
  "version": "0.1.0",
  "identifier": "com.w1ve.remotekeyer",
  "build": {
    "frontendDist": "web/dist",
    "devUrl": "http://localhost:5175",
    "beforeDevCommand": {
      "cwd": "web",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "web",
      "script": "npm run build"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "W1VE Remote Keyer",
        "width": 760,
        "height": 560,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
